    "slides": [
      {
        "index": 1,
        "text": "You stand in the tea aisle, holding two boxes?one chamomile, one peppermint.",
        "closing": false,
        "text_tone": "LIGHT",
        "logo_tone": "LIGHT",
        "footer_tone": "NAVY",
        "accent": "GOLD"
      },
      {
        "index": 2,
        "text": "You automatically remember which one soothes your mother's evening cough, but you freeze trying to recall your own preference.",
        "closing": false,
        "text_tone": "LIGHT",
        "logo_tone": "LIGHT",
        "footer_tone": "NAVY",
        "accent": "GOLD"
      },
      {
        "index": 3,
        "text": "It feels small, almost silly, until the silence in your head stays blank.",
        "closing": false,
        "text_tone": "LIGHT",
        "logo_tone": "LIGHT",
        "footer_tone": "NAVY",
        "accent": "GOLD"
      },
      {
        "index": 4,
        "text": "Selfhood doesn't usually vanish overnight; it fades through hundreds of quiet choices where your taste steps aside.",
        "closing": false,
        "text_tone": "LIGHT",
        "logo_tone": "LIGHT",
        "footer_tone": "NAVY",
        "accent": "GOLD"
      },
      {
        "index": 5,
        "text": "Today, if you can, notice one small choice that belongs entirely to your own taste.",
        "closing": true,
        "text_tone": "LIGHT",
        "logo_tone": "LIGHT",
        "footer_tone": "NAVY",
        "accent": "GOLD"
      }
